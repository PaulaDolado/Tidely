{
  "expo": {
    "name": "Tidely",
    "slug": "tidely",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tidely.app"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.tidely.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-image-picker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F7F4F1"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "53f47287-3a1c-4057-a710-b7e69aa125f3"
      }
    },
    "owner": "pauladolado"
  }
}
