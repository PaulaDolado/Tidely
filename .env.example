# Base de datos
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/life_organizer"
# La usa la CLI de Prisma para migrar (`prisma migrate`) — sin un pooler delante (como aquí, en
# local), es la MISMA cadena que DATABASE_URL. Si usas un proveedor con pooler (p.ej. Supabase:
# DATABASE_URL = conexión pooled del puerto 6543 con "?pgbouncer=true", DIRECT_URL = conexión
# directa del puerto 5432), aquí SÍ deben ser distintas — ver DEPLOYMENT.md#usar-supabase-como-postgres.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/life_organizer"

# Servidor
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET="cambia-este-secreto-en-produccion"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_SECRET="cambia-este-secreto-refresh-en-produccion"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS
CORS_ORIGIN="http://localhost:5173"

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# Límite propio (más estricto) para /auth — protege login/register de fuerza bruta.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Integración con Google Calendar (opcional — sin esto, la app funciona igual, esa integración
# simplemente aparece como "no configurada"). Créalas en https://console.cloud.google.com/
# ("APIs & Services" > "Credentials" > "Create OAuth client ID", tipo "Web application"),
# habilitando antes la "Google Calendar API" en la biblioteca de APIs.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Debe coincidir EXACTAMENTE con un "Authorized redirect URI" del cliente OAuth de arriba.
GOOGLE_REDIRECT_URI="http://localhost:3000/integrations/google/callback"
# Clave para cifrar en reposo los tokens de Google Calendar guardados en la base de datos (ver
# utils/encryption.ts) — obligatoria si rellenas GOOGLE_CLIENT_ID/SECRET de arriba, si no la
# integración responde "no configurada" igual que sin esas dos. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""
