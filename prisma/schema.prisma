// Tidely API — Prisma schema
// Ver: Life_Organizer_API_Especificacion.docx, sección 4

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // `url`: la usa Prisma Client en tiempo de ejecución — normalmente la conexión POOLED cuando
  // el proveedor de Postgres tiene pooler (p.ej. Supabase por PgBouncer/Supavisor, puerto 6543).
  // `directUrl`: la usa la CLI de Prisma (`migrate`, `db push`, `db pull`) para migrar — el modo
  // transacción de un pooler puede romper los advisory locks que necesita migrar, así que estas
  // operaciones van siempre por la conexión DIRECTA (puerto 5432), nunca por el pooler.
  // Sin un pooler delante (Postgres local, Docker, Railway/Render sin Supabase) las dos apuntan a
  // la MISMA cadena de conexión — ver .env.example y DEPLOYMENT.md#usar-supabase-como-postgres.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  // Alias de login, alternativo al email — se elige al registrarse. Junto con `email`, ambos
  // sirven para iniciar sesión (ver authService.login: busca por email O por username).
  username     String   @unique
  password     String // bcrypt hash
  name         String
  lastName     String?
  // Cuándo se cambió el username por última vez — null si nunca se ha cambiado desde el
  // registro. Sirve para limitar el cambio a 1 vez cada 15 días (antes aplicaba al email,
  // antes de separar ambos conceptos: ver comentario en authService.ts).
  usernameChangedAt DateTime?
  // Verificación de email: null hasta que se confirma. El login NO exige tenerlo verificado
  // (se puede usar la app desde el registro), pero el frontend muestra un aviso hasta que se
  // confirme. Cambiar el email (a diferencia del username) resetea esto a null y manda un
  // nuevo email de verificación — no tiene cooldown propio, la verificación ya frena el abuso.
  emailVerifiedAt            DateTime?
  emailVerificationTokenHash String?
  emailVerificationExpiresAt DateTime?
  timezone     String   @default("Europe/Madrid")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  events        Event[]
  goals         Goal[]
  goalProgress  GoalProgress[]
  transactions  Transaction[]
  savingsGoals  SavingsGoal[]
  projects      Project[]
  notifications Notification[]
  tasks         Task[]
  planners      Planner[]
  notes         Note[]
  habits        Habit[]
  habitLogs     HabitLog[]
  syncTombstones SyncTombstone[]
  schedules     Schedule[]
  customPages   CustomPage[]
  calendarLegendCategories CalendarLegendCategory[]
  calendarDayMarks         CalendarDayMark[]
  eventCategories          EventCategory[]
  googleCalendarConnection GoogleCalendarConnection?

  @@index([emailVerificationTokenHash])
}

model Event {
  id               Int      @id @default(autoincrement())
  userId           Int
  title            String
  description      String?
  // Deprecado: antes era la categoría del evento, de una lista fija de 9 valores ("work",
  // "study"...). Ahora la categoría es `categoryId` (ver EventCategory, gestionable por el
  // usuario), pero esta columna se mantiene tal cual para no perder el dato en eventos antiguos
  // ni romper integraciones que aún la lean — al crear/editar se sigue rellenando con el `label`
  // de la categoría elegida, mejor que dejarla huérfana.
  type             String
  // Categoría del evento (color + nombre que el usuario gestiona en Agenda > + Nuevo evento —
  // ver EventCategory). Nullable: null = "sin categoría" (p.ej. eventos importados por .ics, o
  // cuya categoría se borró — onDelete: SetNull, borrar una categoría no borra sus eventos).
  categoryId       Int?
  startTime        DateTime
  endTime          DateTime
  location         String?
  isRecurring      Boolean  @default(false)
  recurringPattern String? // "daily", "weekly", "biweekly", "monthly", "weekday_range"
  // Solo con recurringPattern = "weekday_range": rango de días de la semana que repite (p.ej.
  // lunes a viernes), en vez de un único día fijo — convención ISO 1=lunes..7=domingo, para que
  // "lunes a viernes" sea literalmente 1 a 5. Si `recurringWeekdayStart > recurringWeekdayEnd` el
  // rango da la vuelta a la semana (p.ej. 5 a 1 = viernes, sábado, domingo, lunes) — ver
  // utils/recurrence.ts:matchesWeekdayRange.
  recurringWeekdayStart Int?
  recurringWeekdayEnd   Int?
  // Antelación(es) de aviso, en minutos (p.ej. [15, 1440] = 15 min y 1 día antes). Sustituye el
  // recordatorio fijo de ~30 min que antes generaba `notificationService` para todos los eventos
  // por igual — cada evento configura los suyos, y puede tener varios o ninguno ([]).
  reminderMinutesBefore Int[] @default([30])
  // Invitados: lista simple de nombres/emails sin flujo de invitación/aceptación (la app sigue
  // siendo mono-usuario) — solo para llevar constancia de quién viene al evento.
  guests           String[] @default([])
  // Origen del evento: "tidely" (creado a mano, el caso normal) o "google" (importado por la
  // integración de solo lectura con Google Calendar, ver googleCalendarService). `googleEventId`
  // solo se rellena en el segundo caso — es el id que Google da a esa instancia concreta
  // (con singleEvents:true cada ocurrencia de una serie recurrente ya llega expandida con su
  // propio id, así que no hace falta replicar aquí su RRULE). El índice único (userId,
  // googleEventId) evita reimportar el mismo evento dos veces en cada sincronización; Postgres
  // permite múltiples NULL en un índice único, así que no afecta a los eventos "tidely" normales.
  source           String   @default("tidely")
  googleEventId    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   EventCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  exceptions EventException[]

  @@index([userId])
  @@index([userId, startTime])
  @@index([userId, categoryId])
  @@unique([userId, googleEventId])
}

// Excepción a UNA ocurrencia concreta de una serie recurrente — mover o cancelar esa ocurrencia
// sin tocar el resto de la serie ni la plantilla. `originalStartTime` es el startTime que
// `expandRecurringEvent` habría calculado para ella de no existir la excepción; sirve de
// identificador estable de "qué ocurrencia es" incluso después de moverla (ver utils/recurrence.ts).
// Único (eventId, originalStartTime): como mucho una excepción por ocurrencia — pasar de "moved"
// a "cancelled" es un update sobre la misma fila, no una fila nueva.
model EventException {
  id                Int       @id @default(autoincrement())
  eventId           Int
  originalStartTime DateTime
  status            String // "moved" | "cancelled"
  newStartTime      DateTime?
  newEndTime        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, originalStartTime])
  @@index([eventId])
}

// Categoría de evento (Agenda > + Nuevo evento): el usuario puede añadir las que quiera, con el
// color que quiera de la paleta de la app (ver CALENDAR_COLORS/CalendarLegendCategory — mismo
// concepto reutilizado aquí, no una tabla compartida porque una cosa es la leyenda del calendario
// anual y otra la categoría de un evento), renombrarlas o borrarlas — incluidas las 9 que trae la
// cuenta por defecto (creadas al registrarse, ver authService.register; las cuentas ya existentes
// las reciben en la migración que añadió esta tabla). Borrar una categoría no borra los eventos
// que la usaban (ver Event.categoryId: onDelete SetNull) — simplemente se quedan sin categoría.
model EventCategory {
  id        Int      @id @default(autoincrement())
  userId    Int
  label     String
  color     String // clave de la paleta de la app: "primary" | "secondary" | "habit" | "hobby" | "positive" | "negative" | "warning" | "muted"
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  events Event[]

  @@index([userId, order])
}

model Goal {
  id           Int      @id @default(autoincrement())
  userId       Int
  title        String
  description  String?
  period       String // "weekly" | "monthly" | "annual"
  targetValue  Int // meta numérica (ej: 7 días, 20 horas)
  currentValue Int      @default(0)
  completed    Boolean  @default(false)
  bonusPoints  Int      @default(10) // puntos si completa
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  periodStart  DateTime
  periodEnd    DateTime
  // Se pone a true cuando pasa `periodEnd` sin completarse (la archiva el scheduler de
  // src/jobs/goalExpiryScheduler.ts). Distinto de `completed`: una meta puede expirar sin
  // completarse, o completarse antes de expirar.
  expired      Boolean  @default(false)
  // Si es true (default), al expirar se crea automáticamente la meta del siguiente periodo
  // con los mismos datos (título, targetValue, etc.) y progreso en cero — así no hay que
  // recrear a mano "ejercicio 5 días" cada semana.
  autoRenew    Boolean  @default(true)

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  progress GoalProgress[]

  @@index([userId])
  @@index([periodEnd, expired])
}

model GoalProgress {
  id     Int      @id @default(autoincrement())
  goalId Int
  userId Int
  value  Int // valor agregado hoy
  date   DateTime @default(now())
  note   String?

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([goalId, date])
}

model Transaction {
  id          Int      @id @default(autoincrement())
  userId      Int
  type        String // "income" | "expense"
  amount      Decimal  @db.Decimal(12, 2)
  category    String // "salary", "food", "transport", "entertainment", etc.
  description String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model SavingsGoal {
  id            Int       @id @default(autoincrement())
  userId        Int
  name          String // "Ahorro Vacaciones", "Fondo Emergencia"
  type          String    @default("ahorro") // "ahorro" | "inversion" — puramente de agrupación/visualización
  targetAmount  Decimal   @db.Decimal(12, 2)
  currentAmount Decimal   @default(0) @db.Decimal(12, 2)
  category      String // para filtrar transacciones que cuenten
  // Valor de cada "casilla" en la vista de progreso (ej. 100€ por casilla). Puramente de
  // presentación: no afecta al cálculo de currentAmount (que sigue siendo la suma de
  // transacciones de `category`) — solo determina cuántas casillas se dibujan y cuánto
  // aporta cada clic.
  stepAmount    Decimal   @default(100) @db.Decimal(12, 2)
  deadline      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Project {
  id          Int       @id @default(autoincrement())
  userId      Int
  title       String
  description String?
  status      String // "idea", "en_curso", "pausado", "completado"
  priority    String // "low", "medium", "high"
  deadline    DateTime?
  // Color de la "carpeta" en la galería del dashboard (ver NotebookCover en ProyectosPage.tsx):
  // "cover" | "sand" | "sage", elegido al crear el proyecto. Nullable porque los proyectos
  // creados antes de este campo no tienen uno — la galería cae entonces a su rotación por índice
  // de siempre en vez de a un color fijo.
  color       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks ProjectTask[]
  pages ProjectPage[]
  // Tareas del Planificador (tablero kanban) vinculadas a este proyecto — distinto de `tasks`
  // (ProjectTask, el checklist de la "libreta" del proyecto). Vínculo opcional: una tarea del
  // planificador puede no pertenecer a ningún proyecto.
  plannerTasks Task[]

  @@index([userId])
}

// Páginas de la "libreta" de un proyecto: contenido enriquecido (listas, imágenes embebidas
// como data URL, negrita/cursiva...) que el dashboard edita como HTML, al estilo de un
// documento de texto. Distinto de ProjectTask (los "apuntes rápidos" tipo checklist).
model ProjectPage {
  id        Int      @id @default(autoincrement())
  projectId Int
  title     String   @default("Página sin título")
  content   String   @default("") @db.Text
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, order])
}

model ProjectTask {
  id          Int       @id @default(autoincrement())
  projectId   Int
  title       String
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// Un tablero de planificador con nombre propio (p.ej. "Trabajo", "Personal") — mismo patrón que
// Schedule (Horario): el usuario puede tener varios y verlos de uno en uno con flechas o todos
// apilados (ver PlanificadorPage). `order` es el orden entre ellos.
model Planner {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks  Task[]
  fields PlannerField[]

  @@index([userId, order])
}

// Columna personalizada definida por el usuario para UN planner concreto (no global — cada
// tablero tiene las suyas, como las propiedades de una base de datos de Notion). `options` solo
// se usa cuando `type` es "select" (la lista de opciones entre las que elegir); el valor real de
// cada tarea para este campo vive en Task.customFields, indexado por este `id`.
model PlannerField {
  id        Int      @id @default(autoincrement())
  plannerId Int
  name      String
  type      String // "text" | "number" | "date" | "select"
  options   String[] @default([])
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  planner Planner @relation(fields: [plannerId], references: [id], onDelete: Cascade)

  @@index([plannerId, order])
}

// Planificador de tareas (submenú de Agenda): tablero kanban con tres columnas fijas, dentro de
// un Planner (el usuario puede tener varios, ver arriba). `order` es un float para poder insertar
// una tarea entre otras dos sin tener que renumerar el resto de la columna (orden = punto medio
// entre las tarjetas vecinas).
model Task {
  id          Int       @id @default(autoincrement())
  userId      Int
  plannerId   Int // a qué tablero de planificador pertenece — ver Planner
  projectId   Int? // vínculo opcional a un Project — ver comentario en Project.plannerTasks
  title       String
  description String?
  // Imagen embebida como data URL (igual que RichTextEditor.insertImage y el kanban de páginas
  // personalizadas) — @db.Text porque una foto en base64 pesa mucho más que el resto de campos.
  image       String?   @db.Text
  // Recuadro grande de texto libre del diálogo de detalles, SIN nombre/etiqueta en la interfaz a
  // propósito (ver TaskDetailDialog en el dashboard): "todo lo demás" que no encaja en la
  // descripción corta — apuntes, contexto, lo que sea. @db.Text por la misma razón que `image`.
  notes       String?   @db.Text
  status      String    @default("todo") // "todo" | "in_progress" | "done"
  priority    String    @default("medium") // "low" | "medium" | "high"
  order       Float     @default(0)
  dueDate     DateTime? // fecha límite; dispara un recordatorio (ver notificationService.createTaskDueReminders)
  tags        String[]  @default([])
  estimatedMinutes Int? // estimación previa, en minutos
  actualMinutes    Int  @default(0) // acumulado real registrado vía POST /planner/tasks/:id/time
  // Valores de las columnas personalizadas de este planner (ver PlannerField): objeto plano
  // { [fieldId]: valor }, con el valor como string (texto/fecha ISO/opción elegida) o number
  // (tipo "número") — igual patrón de "blob JSON de valores sueltos" que CustomPage.content, así
  // que añadir/quitar columnas personalizadas no pide migración.
  customFields Json      @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planner  Planner   @relation(fields: [plannerId], references: [id], onDelete: Cascade)
  project  Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  subtasks Subtask[]

  @@index([userId, status])
  @@index([userId, dueDate])
  @@index([plannerId, status])
  @@index([projectId])
}

// Checklist dentro de una tarea del planificador (subtareas). Sin `order` propio: son listas
// cortas que se reordenan poco, así que basta con el orden de creación (`id`/`createdAt`).
model Subtask {
  id        Int      @id @default(autoincrement())
  taskId    Int
  title     String
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  // Cursor de sincronización (ver syncService.ts) — se edita in-place (título/completed), así
  // que necesita su propio "qué cambió desde X", a diferencia de HabitLog (solo alta/baja).
  updatedAt DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

// Notas rápidas de la Agenda: apuntes sueltos sin fecha ni hora (recordatorios tipo post-it),
// distintas de los Event — no ocupan bloque en el calendario, solo una lista simple.
model Note {
  id        Int      @id @default(autoincrement())
  userId    Int
  content   String
  checked   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt // ver comentario en Subtask.updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Seguimiento de hábitos diarios (widget de Agenda, junto a Progreso de objetivos): a diferencia
// de Goal (un número acumulado hacia una meta con fecha de fin), un hábito no "se completa" — se
// repite indefinidamente y lo que importa es la racha de días seguidos marcados.
model Habit {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt // ver comentario en Subtask.updatedAt

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs HabitLog[]

  @@index([userId, active])
}

// Un registro = "cumplido ese día". Marcar/desmarcar es solo crear o borrar la fila del día
// (en vez de un booleano por día, así el historial completo queda disponible para la racha
// y el mapa de calor sin tener que guardar 365 filas vacías por hábito y año).
model HabitLog {
  id        Int      @id @default(autoincrement())
  habitId   Int
  userId    Int
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([userId, date])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String // "event_reminder" | "goal_at_risk" | "task_due"
  title     String
  message   String
  relatedId Int? // eventId (series), goalId o taskId, según `type`
  // Para "event_reminder": el startTime de la ocurrencia concreta que generó el aviso
  // (los eventos recurrentes no materializan una fila por ocurrencia — ver utils/recurrence.ts —
  // así que esto es lo que distingue un recordatorio de "el lunes" de uno de "el martes siguiente").
  // Para "goal_at_risk": no hay una "ocurrencia" real, así que se usa como bucket de "día
  // natural" (inicio del día en UTC) — como mucho una alerta por meta y día, se lea o no la de
  // hoy (ver notificationService.createGoalRiskAlerts, y por qué desduplicar solo por "sin leer"
  // se sentía como spam).
  occurrenceAt DateTime?
  // Solo relevante para type="event_reminder": con cuántos minutos de antelación se generó ESTE
  // aviso concreto (ver Event.reminderMinutesBefore). Un evento puede tener varios avisos
  // configurados (15 min y 1 día antes, por ejemplo) para la MISMA ocurrencia — sin este campo,
  // ambos compartirían (relatedId, occurrenceAt) y la deduplicación descartaría el segundo por
  // "duplicado" cuando en realidad es un aviso distinto.
  offsetMinutesBefore Int?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([type, relatedId, occurrenceAt])
}

// Rastro de borrados para la sincronización offline del móvil (ver syncService.ts): los deletes
// de esta app son siempre hard deletes (prisma.X.delete), así que sin esto un cliente que
// llevara tiempo desconectado nunca se enteraría de que una fila desapareció — el pull de sync
// devuelve estas filas junto a los cambios normales para que el móvil borre su copia local.
// Solo cubre los modelos de la Fase 1 de sync (Event/EventException, Task/Subtask, Note,
// Habit/HabitLog) — el resto de módulos (Finanzas, Proyectos, Hobbies, Objetivos...) no
// sincroniza con el móvil todavía y sus deletes no generan tombstone.
model SyncTombstone {
  id         Int      @id @default(autoincrement())
  userId     Int
  entityType String // "event" | "eventException" | "task" | "subtask" | "note" | "habit" | "habitLog"
  entityId   Int
  deletedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deletedAt])
}

// Página personalizada creada desde "+ Nueva página" (menú lateral del dashboard): el usuario
// elige un "modelo" al crearla (una libreta en blanco, un kanban, o una versión simplificada e
// independiente de Finanzas/Proyectos/Objetivos/Agenda/Hoy) y le pone el nombre que quiera.
// A diferencia de esas secciones "de verdad" (Project, Goal, Transaction...), aquí NO hay tabla
// propia por tipo de contenido: `content` guarda el JSON con la forma que le corresponda a
// `template` (columnas y tarjetas para kanban, HTML para nota, entradas para finanzas...) — el
// dashboard sabe interpretarlo según `template`. Igual que ProjectPage.content, se sobrescribe
// entero en cada guardado en vez de tener endpoints por sub-elemento.
model CustomPage {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  // Línea bajo el título en la cabecera (ver CustomPagePage) — libre, la escribe el usuario; si
  // es null se muestra el icono+nombre de la plantilla como valor por defecto (ver meta.label en
  // customPageTemplates.ts), sin que eso quede guardado como si lo hubiera escrito él.
  subtitle  String?
  // "nota" | "kanban" | "finanzas" | "proyectos" | "objetivos" | "agenda" | "hoy"
  template  String
  order     Int      @default(0)
  content   Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, order])
}

// Un horario con nombre propio (p.ej. "1r trimestre", "2n semestre") — Agenda > Horario. El
// usuario puede tener varios a la vez (uno por trimestre/semestre) y elegir verlos apilados o de
// uno en uno con flechas (ver SchedulePage en el dashboard); `order` es el orden entre ellos.
model Schedule {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  rows ScheduleRow[]

  @@index([userId, order])
}

// Fila de un Schedule: un bloque horario (una franja) con una celda de texto libre por día de
// lunes a viernes; a diferencia de Event, no tiene fecha: es la misma plantilla semana tras
// semana, y el usuario rellena cada celda a mano (no hay concepto de "asignatura" estructurado,
// solo texto libre por celda).
model ScheduleRow {
  id         Int      @id @default(autoincrement())
  scheduleId Int
  order      Int      @default(0)
  timeLabel  String   @default("") // texto libre, p.ej. "08:00 - 10:00"
  monday     String   @default("")
  tuesday    String   @default("")
  wednesday  String   @default("")
  thursday   String   @default("")
  friday     String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId, order])
}

// Categoría de la leyenda del calendario anual (Horario > vista anual, ver AnnualCalendarLegend
// en el dashboard) — nombre + color elegido de la paleta de la propia app (ver CALENDAR_COLORS
// en el dashboard). Una única leyenda compartida para toda la cuenta, independiente de cuántos
// Schedule tenga el usuario — el calendario anual no pertenece a ningún trimestre en concreto.
model CalendarLegendCategory {
  id        Int      @id @default(autoincrement())
  userId    Int
  label     String
  color     String // clave de la paleta de la app: "primary" | "secondary" | "habit" | "hobby" | "positive" | "negative" | "warning" | "muted"
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  days CalendarDayMark[]

  @@index([userId, order])
}

// Un día del calendario anual pintado con una categoría de la leyenda. Un día por fila (no un
// rango startDate..endDate): pintar varios días seguidos es simplemente crear varias filas desde
// el dashboard (arrastrando sobre el calendario) — así borrar o repintar un solo día del medio de
// un tramo largo no obliga a partir un rango en dos.
model CalendarDayMark {
  id         Int      @id @default(autoincrement())
  userId     Int
  categoryId Int
  date       DateTime @db.Date

  user     User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  category CalendarLegendCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([categoryId])
}

// Conexión OAuth de un usuario con su Google Calendar (ver googleCalendarService) — de momento
// solo importación de solo lectura del calendario "primary", nunca escribe en Google. Uno por
// usuario. Los tokens se guardan tal cual (no se pueden hashear como una contraseña: hace falta
// el valor real para llamar a la API de Google en cada sincronización) — igual que cualquier
// integración OAuth de servidor a servidor.
model GoogleCalendarConnection {
  id           Int       @id @default(autoincrement())
  userId       Int       @unique
  googleEmail  String
  accessToken  String    @db.Text
  refreshToken String    @db.Text
  expiryDate   DateTime
  // Null hasta la primera sincronización — se muestra en el dashboard para que el usuario sepa
  // si los datos importados están al día.
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
